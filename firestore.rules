rules_version = '2';

// The whole tree is pinned to ONE human: the owner's Firebase Auth UID,
// captured from the first live sign-in on the A56 (2026-09-01). Desktop
// is unaffected: its REST path authenticates via project-owner IAM, not
// these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == 'Gw7Cr5OB2TVucnSUNAFOhXEB7hW2';
    }
  }
}
